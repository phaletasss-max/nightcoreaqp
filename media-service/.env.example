# ── Media-service (servidor Arch) ────────────────────────────────────────────
# Copia a ".env" y completa. Cárgalo con un gestor de procesos (pm2/systemd) o
# `node --env-file=.env server.js` (Node 20+).

PORT=8787

# Frontend autorizado (CORS). Coma-separado. Usa el dominio real de Vercel.
ALLOWED_ORIGINS=https://nightcore-aqp.vercel.app,http://localhost:3092

# Supabase (clave de SERVICIO, solo backend — NUNCA en el frontend)
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...tu-service-role-key
SUPABASE_BUCKET=media

# ── PO Tokens (anti-bloqueo de YouTube) ──────────────────────────────────────
# El contenedor arranca el provider bgutil y yt-dlp lo usa para parecer tráfico
# legítimo. Si Render gratis se queda sin RAM (reinicios en bucle), pon false.
ENABLE_POT=true
# POT_PORT=4416                       # puerto interno del provider (default 4416)
# POT_BASE_URL=http://127.0.0.1:4416  # solo si el provider corre en otra parte

# Cookies de YouTube (recomendado junto con PO Tokens). Ruta a un cookies.txt.
# En Render: súbelo como Secret File y apunta aquí (p. ej. /etc/secrets/cookies.txt).
# YTDLP_COOKIES=/etc/secrets/cookies.txt
