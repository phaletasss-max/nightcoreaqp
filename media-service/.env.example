# ── Media-service (servidor Arch) ────────────────────────────────────────────
# Copia a ".env" y completa. Cárgalo con un gestor de procesos (pm2/systemd) o
# `node --env-file=.env server.js` (Node 20+).

PORT=8787

# Frontend autorizado (CORS). Coma-separado. Usa el dominio real de Vercel.
ALLOWED_ORIGINS=https://nightcore-aqp.vercel.app,http://localhost:3092

# Supabase (clave de SERVICIO, solo backend — NUNCA en el frontend)
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...tu-service-role-key
SUPABASE_BUCKET=media
