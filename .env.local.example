# ── Supabase ──────────────────────────────────────────────────────────────────
# Copia este archivo a ".env.local" y reemplaza con los valores reales de tu proyecto.
# Los encuentras en: Supabase Dashboard → Project Settings → API
#
# NUNCA subas .env.local al repo (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu-anon-key-aqui

# ── Media-service (servidor Arch con yt-dlp) ──────────────────────────────────
# URL HTTPS del microservicio de descargas. Déjalo vacío hasta desplegarlo:
# mientras tanto, las descargas se deshabilitan y la validación de links degrada.
NEXT_PUBLIC_MEDIA_SERVICE_URL=https://tu-media-service.tudominio.com

# ── Spotify (server-side, importar playlists) ─────────────────────────────────
SPOTIFY_CLIENT_ID=tu-client-id
SPOTIFY_CLIENT_SECRET=tu-client-secret

# ── Asistente (Gemini) ────────────────────────────────────────────────────────
# Key de Google AI Studio: https://aistudio.google.com/apikey
# Vive solo en el server (ruta /api/assistant). Sin esto, el chat avisa "no configurada".
GEMINI_API_KEY=tu-api-key-de-gemini
# GEMINI_MODEL=gemini-2.0-flash   # opcional
